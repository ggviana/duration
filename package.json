{
  "name": "duration",
  "version": "0.1.0",
  "description": "A TypeScript library for duration utilities",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "keywords": [
    "typescript",
    "library"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "2.27.10",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.18.0",
    "husky": "9.1.7",
    "lint-staged": "15.2.11",
    "neostandard": "0.12.2",
    "tsup": "8.3.5",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
